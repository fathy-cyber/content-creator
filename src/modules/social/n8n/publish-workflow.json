              "value2": 3
            }
          ]
        }
      },
      "id": "node-42",
      "name": "Platform — Can Retry?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [4700, 750]
    },

    {
      "parameters": {
        "jsCode": "// Network error: retry once immediately\nconst upstream = $json;\nconst retry_count = upstream.retry_count ?? 0;\n\nif (retry_count >= 1) {\n  // Classify as platform error for second attempt\n  return [{ json: { ...upstream, error_code: 'platform', retry_count: retry_count + 1, wait_minutes: 2 } }];\n}\n\nreturn [{ json: { ...upstream, retry_count: retry_count + 1, wait_minutes: 0, retry_reason: 'network' } }];"
      },
