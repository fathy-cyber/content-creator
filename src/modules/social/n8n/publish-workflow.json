    {
      "parameters": {
        "jsCode": "// Rate limit: update DB status, wait for window reset\nconst upstream = $json;\n\n// Update publish_job status to 'retrying'\nreturn [{\n  json: {\n    ...upstream,\n    retry_reason: 'rate_limit',\n    wait_minutes: 60 // wait 1 hour then retry via pg_cron re-trigger\n  }\n}];"
      },
      "id": "node-38",
      "name": "Handle — Rate Limit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [4500, 550]
    },

    {
      "parameters": {
        "jsCode": "// Auth error: check retry_count, attempt token refresh once\nconst upstream = $json;\nconst retry_count = upstream.retry_count ?? 0;\n\nif (retry_count >= 1) {\n  // Already retried auth once — escalate to fatal\n  return [{ json: { ...upstream, error_code: 'fatal', error_message: 'Auth retry exhausted' }, pairedItem: { item: 0 } }];\n}\n\nreturn [{ json: { ...upstream, retry_count: retry_count + 1, retry_reason: 'auth' } }];"
      },
      "id": "node-39",
      "name": "Handle — Auth (Check Retry)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [4500, 650]
    },

    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.retry_count }}",
              "operation": "smallerEqual",
              "value2": 1
            }
          ]
        }
      },
      "id": "node-40",
      "name": "Auth — Can Retry?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [4700, 650]
    },

    {
      "parameters": {
        "jsCode": "// Platform error: exponential backoff\n// Retry up to max_retries (3)\nconst upstream = $json;\nconst retry_count = upstream.retry_count ?? 0;\nconst max_retries = 3;\n\nif (retry_count >= max_retries) {\n  return [{ json: { ...upstream, error_code: 'fatal', error_message: `Max retries (${max_retries}) exhausted` } }];\n}\n\n// Exponential backoff: 2^retry_count minutes\nconst wait_minutes = Math.pow(2, retry_count);\n\nreturn [{\n  json: {\n    ...upstream,\n    retry_count: retry_count + 1,\n    wait_minutes,\n    retry_reason: 'platform'\n  }\n}];"
      },
      "id": "node-41",
      "name": "Handle — Platform (Backoff)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [4500, 750]
    },

    {
      "parameters": {
        "conditions": {
